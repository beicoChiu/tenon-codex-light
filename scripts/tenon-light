#!/usr/bin/env python3
"""CLI scaffold for Tenon Codex Light."""

from __future__ import annotations

import argparse
from pathlib import Path
import sys

PROJECT_ROOT = Path(__file__).resolve().parents[1]
SRC_ROOT = PROJECT_ROOT / "src"
if str(SRC_ROOT) not in sys.path:
    sys.path.insert(0, str(SRC_ROOT))

from tenon_codex_light.protocol import EffectControl, HsvColor, build_effect_json_payload, build_hsv_payload
from tenon_codex_light.ble_scan import BleakMissingError, BleScanError, format_scan_result, run_scan
from tenon_codex_light.ble_write import (
    BleWriteError,
    ColorWriteRequest,
    EffectWriteRequest,
    WriteMode,
    run_write_effect_control,
    run_write_hsv_color,
)
from tenon_codex_light.daemon import NativeAppDaemonRunner
from tenon_codex_light.state_file import default_state_file, write_state_file
from tenon_codex_light.states import parse_state


def format_payload(payload: bytes) -> str:
    return " ".join(f"{byte:02X}" for byte in payload)


def main() -> int:
    parser = argparse.ArgumentParser(prog="tenon-light")
    subparsers = parser.add_subparsers(dest="command", required=True)

    scan_parser = subparsers.add_parser("scan", help="scan for Tenon BLE devices")
    scan_parser.add_argument("--services", action="store_true", help="include service and characteristic details")
    scan_parser.add_argument("--verbose", action="store_true", help="print detailed discovery output")
    scan_parser.add_argument("--verbose-identifiers", action="store_true", help="print full BLE device identifiers for local setup")
    scan_parser.add_argument("--duration", type=float, default=5.0, help="scan duration in seconds")

    color_parser = subparsers.add_parser("color", help="set an HSV color")
    color_parser.add_argument("--h", type=int, required=True)
    color_parser.add_argument("--s", type=int, required=True)
    color_parser.add_argument("--v", type=int, default=20, help="HSV value/brightness, defaults to 20 for safer write probes")
    color_parser.add_argument("--address", help="explicit BLE device address/identifier")
    color_parser.add_argument("--service-uuid", help="explicit Tenon service UUID")
    color_parser.add_argument("--characteristic-uuid", help="explicit Tenon light characteristic UUID")
    color_parser.add_argument("--dry-run", action="store_true", help="print payload without writing")
    color_parser.add_argument("--verbose", action="store_true", help="print selected BLE options and payload")
    color_parser.add_argument(
        "--write-mode",
        choices=["response", "no-response"],
        default="response",
        help="BLE write mode to use once hardware write is implemented",
    )

    effect_parser = subparsers.add_parser("effect", help="dry-run existing Tenon BLE effect payload")
    effect_parser.add_argument(
        "effect",
        choices=["none", "blink", "breathe", "moving", "rolling", "dancing"],
        help="existing Tenon effect action to encode",
    )
    effect_parser.add_argument("--dry-run", action="store_true", help="required; print payload without writing")
    effect_parser.add_argument("--verbose", action="store_true", help="print exact payload bytes and encoded JSON")
    effect_parser.add_argument("--h", type=int, default=210)
    effect_parser.add_argument("--s", type=int, default=80)
    effect_parser.add_argument("--v", type=int, default=50)
    effect_parser.add_argument("--interval-ms", type=int, default=1000)
    effect_parser.add_argument("--address", help="explicit BLE device address/identifier")
    effect_parser.add_argument("--service-uuid", help="explicit Tenon service UUID")
    effect_parser.add_argument("--characteristic-uuid", help="explicit Tenon light characteristic UUID")
    effect_parser.add_argument("--write-mode", choices=["response", "no-response"], default="response")
    effect_parser.add_argument("--i-understand-this-is-experimental", action="store_true")

    state_parser = subparsers.add_parser("state", help="write a validated local light state")
    state_parser.add_argument("state", help="working, needs_input, idle, error, off, or restore")
    state_parser.add_argument("--state-file", type=Path, default=default_state_file())

    daemon_parser = subparsers.add_parser("daemon", help="watch local state file and write Tenon light color")
    daemon_parser.add_argument("--address", required=True, help="explicit allowlisted Tenon BLE device identifier")
    daemon_parser.add_argument("--service-uuid", default="4D543739-3333-2E4F-4E4F-4F2E4445534B")
    daemon_parser.add_argument("--characteristic-uuid", default="4D543739-3333-2E4F-4E4F-4F2E434C4544")
    daemon_parser.add_argument("--state-file", type=Path, default=default_state_file())
    daemon_parser.add_argument("--poll-interval", type=float, default=0.25)
    daemon_parser.add_argument("--app-path", type=Path, default=PROJECT_ROOT / "build" / "Tenon Codex Light Scan.app")
    daemon_parser.add_argument("--once", action="store_true", help="process current state once and exit")
    daemon_parser.add_argument("--disable-effects", action="store_true", help="force HSV fallback instead of two-color effects")

    args = parser.parse_args()

    if args.command == "scan":
        try:
            result = run_scan(duration=args.duration, include_services=args.services)
        except BleakMissingError as exc:
            print(str(exc), file=sys.stderr)
            print("Install it with: python3 -m pip install '.[ble]'", file=sys.stderr)
            return 2
        except BleScanError as exc:
            print(str(exc), file=sys.stderr)
            print("Check that Bluetooth is enabled and this terminal app has Bluetooth permission.", file=sys.stderr)
            return 2
        print(format_scan_result(result, verbose=args.verbose, show_full_identifiers=args.verbose_identifiers))
        return 0

    if args.command == "color":
        color = HsvColor(args.h, args.s, args.v)
        try:
            payload = build_hsv_payload(color)
        except ValueError as exc:
            print(f"invalid color: {exc}", file=sys.stderr)
            return 2

        if args.verbose:
            print(f"address: {args.address or '(not provided)'}")
            print(f"service_uuid: {args.service_uuid or '(not provided)'}")
            print(f"characteristic_uuid: {args.characteristic_uuid or '(not provided)'}")
            print(f"write_mode: {args.write_mode}")
            print(f"dry_run: {args.dry_run}")
        print(f"payload: {format_payload(payload)}")
        if args.dry_run:
            return 0

        try:
            request = ColorWriteRequest(
                address=args.address or "",
                service_uuid=args.service_uuid or "",
                characteristic_uuid=args.characteristic_uuid or "",
                color=color,
                write_mode=WriteMode(args.write_mode),
            )
            run_write_hsv_color(request)
        except (ValueError, BleWriteError) as exc:
            print(str(exc), file=sys.stderr)
            return 2
        print("write: ok")
        return 0

    if args.command == "effect":
        try:
            control = EffectControl(
                effect=args.effect,
                color=HsvColor(args.h, args.s, args.v),
                interval_ms=args.interval_ms,
            )
            payload = build_effect_json_payload(control)
        except ValueError as exc:
            print(str(exc), file=sys.stderr)
            return 2
        print(f"payload: {format_payload(payload)}")
        if args.verbose:
            print(f"command_id: 0x{payload[0]:02X}")
            print(f"json: {payload[1:].decode('utf-8')}")
            print(f"dry_run: {args.dry_run}")
            print(f"write_mode: {args.write_mode}")
        if args.dry_run:
            return 0
        try:
            request = EffectWriteRequest(
                address=args.address or "",
                service_uuid=args.service_uuid or "",
                characteristic_uuid=args.characteristic_uuid or "",
                control=control,
                write_mode=WriteMode(args.write_mode),
                experimental_ack=args.i_understand_this_is_experimental,
            )
            run_write_effect_control(request)
        except (ValueError, BleWriteError) as exc:
            print(str(exc), file=sys.stderr)
            return 2
        print("write: ok")
        return 0

    if args.command == "state":
        try:
            state = parse_state(args.state)
            write_state_file(state, args.state_file)
        except ValueError as exc:
            print(str(exc), file=sys.stderr)
            return 2
        except OSError:
            print("state write failed", file=sys.stderr)
            return 1
        print(f"state: {state.value}")
        return 0

    if args.command == "daemon":
        runner = NativeAppDaemonRunner(
            app_path=args.app_path,
            address=args.address,
            service_uuid=args.service_uuid,
            characteristic_uuid=args.characteristic_uuid,
            state_file=args.state_file,
            poll_interval=args.poll_interval,
            disable_effects=args.disable_effects,
        )
        return runner.run(once=args.once)

    return 1


if __name__ == "__main__":
    sys.exit(main())
