#!/usr/bin/env python3
"""Write one validated workflow light state for command hooks.

This script intentionally does not read stdin or environment hook payloads.
It only accepts a fixed state enum argument (plus optional routing flags) and
writes the local state file. It delegates to the installed console entry point
so this standalone script and the ``tenon-hook-state`` command stay identical,
including the active-source routing gate.
"""

from __future__ import annotations

from pathlib import Path
import sys

PROJECT_ROOT = Path(__file__).resolve().parents[1]
SRC_ROOT = PROJECT_ROOT / "src"
if str(SRC_ROOT) not in sys.path:
    sys.path.insert(0, str(SRC_ROOT))

from tenon_signal_light.hook_cli import main


if __name__ == "__main__":
    sys.exit(main())
